ADMIN_SEED_PASSWORD=
WHATSAPP_NUMBER=+923412126680
INSTAGRAM_HANDLE=alishe_nails

# --- Instagram Graph API (homepage feed sync) -------------------------------
# Requires: an Instagram *Professional* (Business/Creator) account linked to
# a Facebook Page, plus an app on https://developers.facebook.com with the
# instagram_basic permission. Generate a long-lived access token (~60 days,
# re-generate when it expires) and put it + the IG account ID here.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Use https://graph.instagram.com if your token comes from the
# "Instagram API with Instagram Login" flow instead of Facebook Login.
INSTAGRAM_API_BASE=https://graph.facebook.com
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_FETCH_LIMIT=12
INSTAGRAM_FEED_SIZE=8